generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id            String     @id @default(cuid())
  lastName      String
  firstName     String
  middleInitial String?
  suffix        String?
  email         String     @unique
  password      String
  role          Role
  firstLogin    Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  student       students?
  subjects      subjects[]
}

model students {
  serialNumber   String  @id
  trainingPeriod Int
  trainingYear   Int
  rank           String
  afos           String
  course         String?
  remarks        String
  userId         String  @unique
  user           users   @relation(fields: [userId], references: [id])
}

model otp {
  id        String @id @default(cuid())
  userEmail String
  otp       String @db.VarChar(6)
}

model training_periods {
  id        Int      @id(map: "training_period_pkey") @default(autoincrement())
  name      String   @db.VarChar
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  weeks     Int
  afos      afos[]
}

model afos {
  code             String           @id @db.VarChar
  name             String           @db.VarChar
  level            Level
  trainingPeriodId Int
  trainingPeriod   training_periods @relation(fields: [trainingPeriodId], references: [id])
  modules          modules[]
}

model modules {
  id       Int        @id @default(autoincrement())
  number   Int
  name     String     @db.VarChar
  afosCode String?    @db.VarChar
  afos     afos?      @relation(fields: [afosCode], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "afos")
  subjects subjects[]
}

model subjects {
  code         String  @id @db.VarChar
  name         String  @db.VarChar
  instructorId String?
  moduleId     Int
  users        users?  @relation(fields: [instructorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "instructor")
  modules      modules @relation(fields: [moduleId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "module")
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum Level {
  Basic
  Advanced
}
