generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id            String     @id @default(cuid())
  lastName      String
  firstName     String
  middleInitial String?
  suffix        String?
  email         String     @unique
  password      String
  role          Role
  firstLogin    Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  student       students?
  subjects      subjects[]
}

model students {
  serialNumber String   @id
  rank         String
  course       String?
  userId       String   @unique
  courses      courses? @relation(fields: [course], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "courseId")
  user         users    @relation(fields: [userId], references: [id])
}

model otp {
  id        String @id @default(cuid())
  userEmail String
  otp       String @db.VarChar(6)
}

model training_periods {
  id        Int       @id(map: "training_period_pkey") @default(autoincrement())
  name      String    @db.VarChar
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  weeks     Int
  courses   courses[]
}

model modules {
  id       Int        @id @default(autoincrement())
  number   Int
  name     String     @db.VarChar
  afosCode String?    @db.VarChar
  afos     courses?   @relation(fields: [afosCode], references: [code], onDelete: Cascade, map: "afos")
  subjects subjects[]
}

model subjects {
  code         String  @id @db.VarChar
  name         String  @db.VarChar
  instructorId String?
  moduleId     Int
  users        users?  @relation(fields: [instructorId], references: [id], map: "instructor")
  modules      modules @relation(fields: [moduleId], references: [id], onDelete: Cascade, map: "module")
}

model courses {
  code             String           @id(map: "afos_pkey") @db.VarChar
  name             String           @db.VarChar
  level            Level
  trainingPeriodId Int
  training_periods training_periods @relation(fields: [trainingPeriodId], references: [id], onDelete: Cascade)
  modules          modules[]
  students         students[]
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum Level {
  Basic
  Advanced
}
